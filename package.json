{
  "name": "agrox-contryside-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "reinstall": "rm -rf node_modules && pnpm install",
    "dev": "vite --mode development",
    "dev:prod": "vite --mode production",
    "prod": "vite --mode production",
    "build": "tsc && vite build --mode production",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "stylelint": "npx stylelint src/**/*.css src/**/*.less",
    "stylelint:fix": "npx stylelint --fix src/**/*.css src/**/*.less",
    "commit-check": "node script/commitCheck.js",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "~5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@ant-design/x": "^1.5.0",
    "@linaria/babel-preset": "^5.0.4",
    "@linaria/core": "^6.3.0",
    "@linaria/react": "^6.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.1.0",
    "ahooks": "^3.9.0",
    "amfe-flexible": "^2.2.1",
    "antd": "^5.26.6",
    "antd-style": "^3.7.1",
    "axios": "^1.11.0",
    "classnames": "^2.5.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "jotai": "^2.12.5",
    "markdown-it": "^14.1.0",
    "qs": "^6.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/crypto-js": "^4.2.2",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@wyw-in-js/vite": "^0.7.0",
    "eslint": "^9.30.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-spellcheck": "^0.0.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "postcss-plugin-px2rem": "^0.8.1",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
